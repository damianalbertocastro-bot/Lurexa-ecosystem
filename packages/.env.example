# -----------------------------------------------------------------------------
# LUREXA PUBLIC PRODUCT URLS
# -----------------------------------------------------------------------------
# Canonical namespace. Do not add unprefixed aliases such as NEXT_PUBLIC_LEARN_URL.
NEXT_PUBLIC_LUREXA_ECOSYSTEM_URL="http://localhost:3000"
NEXT_PUBLIC_LUREXA_LEARN_URL="http://localhost:3001"
NEXT_PUBLIC_LUREXA_TEACH_URL="http://localhost:3002"
NEXT_PUBLIC_LUREXA_ADMIN_URL="http://localhost:3003"
NEXT_PUBLIC_LUREXA_DOCS_URL="http://localhost:3004"
NEXT_PUBLIC_LUREXA_COACH_URL="http://localhost:3005"
NEXT_PUBLIC_LUREXA_TEACHER_URL="http://localhost:3001"
# Future standalone surfaces currently resolve to ecosystem fallbacks unless explicitly provisioned.
# NEXT_PUBLIC_LUREXA_INSIGHT_URL=""
# NEXT_PUBLIC_LUREXA_STUDIO_URL=""
# NEXT_PUBLIC_LUREXA_CAMPUS_URL=""
NEXT_PUBLIC_APP_ENV="development"

# -----------------------------------------------------------------------------
# FIREBASE CLIENT CONFIGURATION — PUBLIC BY DESIGN
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="lurexa-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="lurexa-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="lurexa-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# -----------------------------------------------------------------------------
# FIREBASE ADMIN / TRUSTED SERVER CONFIGURATION — NEVER NEXT_PUBLIC_
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"lurexa-app","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@lurexa-app.iam.gserviceaccount.com"}'
FIREBASE_PROJECT_ID="lurexa-app"
FIREBASE_STORAGE_BUCKET="lurexa-app.appspot.com"

# -----------------------------------------------------------------------------
# LUREXA AI GATEWAY — SERVER ONLY
# -----------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
OPENROUTER_API_KEY="sk-or-v1-..."
LUREXA_PUBLIC_URL="http://localhost:3001"

# Existing Learn compatibility configuration. New AI callers should use the gateway.
LUREXA_LEARN_TUTOR_MODEL="gemini-2.5-flash"
LUREXA_LEARN_TTS_VOICE="en-US-Neural2-F"

# Task-based model policy. Keep provider/model IDs server-only and configurable.
LUREXA_AI_GEMINI_FAST_MODEL="gemini-2.5-flash"
LUREXA_AI_GEMINI_REASONING_MODEL="gemini-2.5-pro"
LUREXA_AI_OPENROUTER_FAST_MODEL="google/gemini-2.5-flash"
LUREXA_AI_OPENROUTER_REASONING_MODEL="anthropic/claude-sonnet-4"

# -----------------------------------------------------------------------------
# LOCAL FIREBASE EMULATORS — OPTIONAL, NEVER ENABLE IN PRODUCTION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST="127.0.0.1"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT="9099"
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT="8080"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
