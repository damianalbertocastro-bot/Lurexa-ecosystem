{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@lurexa/types": [
        "../../packages/types/src/index.ts"
      ],
      "@lurexa/backend": [
        "../../packages/backend/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
