{
  "extends": "@lurexa/typescript-config/nextjs.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
