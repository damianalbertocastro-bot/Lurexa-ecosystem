    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@lurexa/backend": "workspace:*",
    "@lurexa/eslint-config": "workspace:*",
    "@lurexa/types": "workspace:*",
    "@lurexa/typescript-config": "workspace:*",
    "@lurexa/ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.1",
