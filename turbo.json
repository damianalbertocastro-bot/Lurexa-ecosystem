{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "VERCEL_ENV",
    "NEXT_PUBLIC_LUREXA_ECOSYSTEM_URL",
    "NEXT_PUBLIC_LUREXA_LEARN_URL",
    "NEXT_PUBLIC_LUREXA_TEACHER_URL",
    "NEXT_PUBLIC_LUREXA_COACH_URL",
    "NEXT_PUBLIC_LUREXA_TEACH_URL",
    "NEXT_PUBLIC_LUREXA_ADMIN_URL",
    "NEXT_PUBLIC_LUREXA_INSIGHT_URL",
    "NEXT_PUBLIC_LUREXA_STUDIO_URL",
    "NEXT_PUBLIC_LUREXA_CAMPUS_URL",
    "NEXT_PUBLIC_LUREXA_DOCS_URL",
    "NEXT_PUBLIC_FIREBASE_API_KEY",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
    "NEXT_PUBLIC_FIREBASE_APP_ID",
    "NEXT_PUBLIC_USE_FIREBASE_EMULATOR",
    "NEXT_PUBLIC_FIREBASE_EMULATOR_HOST",
    "NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT",
    "NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT",
    "FIREBASE_SERVICE_ACCOUNT_JSON",
    "FIREBASE_PROJECT_ID",
    "FIREBASE_STORAGE_BUCKET",
    "FIRESTORE_EMULATOR_HOST",
    "GCLOUD_PROJECT",
    "GOOGLE_CLOUD_PROJECT",
    "GEMINI_API_KEY",
    "LUREXA_LEARN_TUTOR_MODEL",
    "LUREXA_LEARN_TTS_VOICE"
  ],

  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
