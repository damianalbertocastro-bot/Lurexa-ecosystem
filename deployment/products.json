  "sharedLayers": [
    {
      "name": "Lurexa Core",
      "deploymentRule": "shared backend/platform packages and trusted services; not an end-user website project"
    },
    {
      "name": "Lurexa Mind",
      "deploymentRule": "shared intelligence layer; not an end-user website project unless a dedicated service is introduced later"
    }
