  "activities": {
    "l1-vocab-greetings": {
      "type": "interactive_vocabulary",
      "interactionModes": ["see_hear", "context_select", "repeat", "retrieve", "use"],
      "items": ["Hello", "Hi", "Good morning", "Good afternoon", "Good evening", "My name is...", "I'm...", "Nice to meet you", "Bye", "Goodbye"]
    },
    "l1-conversation-sofia": {
      "type": "scenario_conversation",
      "aiRole": "Sofia, another A1 learner at a new class in Santo Domingo",
      "learnerGoal": "Greet Sofia, give your name, respond to Nice to meet you, and close the conversation.",
      "targetTurns": { "min": 4, "max": 6 },
      "phraseSupport": ["Hi! I'm...", "My name is...", "Nice to meet you, too.", "Bye!"]
    },
    "l4-conversation-mission": {
      "type": "scenario_conversation",
      "learnerGoal": "Exchange greeting, name and origin; respond; request clarification if needed; close the conversation.",
      "targetSeconds": [60, 90],
      "scaffolding": ["full_phrases", "keywords", "independent"]
    }
  },
  "unitCompletionRule": "Unit completion records evidence and completion status. It does not directly set competency mastery.",
  "nextStepRules": [
    "Strong performance -> recommend Unit 2.",
    "Weak listening + adequate speaking -> recommend Unit 2 plus targeted listening retrieval.",
    "Recurring phonetic issue -> recommend optional phonetics/Coach micro-practice if accessible.",
    "Broad communication breakdown -> targeted Unit 1 review, not automatic full restart."
  ]
}
