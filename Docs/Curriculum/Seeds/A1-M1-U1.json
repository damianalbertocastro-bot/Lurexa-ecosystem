  },
  "unit": {
    "id": "a1-m1-u1-meeting-people",
    "title": "Meeting People",
    "mission": "Start and maintain a short first-time conversation using greetings, names, origin and basic repair strategies.",
    "competencyIds": [
      "EN.A1.LISTEN.PERSONAL_INFO",
      "EN.A1.SPEAK.INTRODUCE_SELF",
      "EN.A1.SPEAK.ASK_BASIC_PERSONAL_QUESTIONS",
      "EN.A1.CONV.GREETING_EXCHANGE",
      "EN.A1.CONV.REQUEST_CLARIFICATION",
      "EN.A1.PHON.SOUND_AWARENESS",
      "EN.A1.PHON.FINAL_CONSONANTS_FOUNDATION",
      "EN.A1.VOC.IDENTITY_AND_GREETINGS",
      "EN.A1.GRAM.BE_FOUNDATION"
