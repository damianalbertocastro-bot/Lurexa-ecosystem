{
  "name": "lurexa",
  "packageManager": "pnpm",
  "apps": [
    {
      "name": "learn-web",
      "path": "apps/learn-web",
      "required": true
    },
    {
      "name": "teacher-portal",
      "path": "apps/teacher-portal",
      "required": true
    },
    {
      "name": "admin-portal",
      "path": "apps/admin-portal",
      "required": true
    },
    {
      "name": "storybook",
      "path": "apps/storybook",
      "required": true
    }
  ],
  "packages": [
    {
      "name": "@lurexa/backend",
      "path": "packages/backend",
      "required": true
    },
    {
      "name": "@lurexa/config",
      "path": "packages/config",
      "required": true
    },
    {
      "name": "@lurexa/sdk",
      "path": "packages/sdk",
      "required": true
    },
    {
      "name": "@lurexa/tokens",
      "path": "packages/tokens",
      "required": true
    },
    {
      "name": "@lurexa/types",
      "path": "packages/types",
      "required": true
    },
    {
      "name": "@lurexa/ui",
      "path": "packages/ui",
      "required": true
    }
  ],
  "tooling": {
    "typescript": true,
    "eslint": true,
    "prettier": true,
    "husky": true,
    "lintStaged": true,
    "commitlint": true,
    "changesets": true,
    "githubActions": true,
    "firebaseEmulator": true
  }
}
