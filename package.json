{
  "name": "lurexa",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter learn-web dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present check-types",
    "check-types": "pnpm -r --if-present check-types",
    "test": "pnpm test:security && pnpm test:integration && pnpm test:e2e",
    "test:security": "pnpm test:learn-rules",
    "test:integration": "pnpm test:learn-mvp-journey && firebase emulators:exec --only firestore --project lurexa-app \"pnpm --filter @lurexa/backend test:signature-delegation\" && firebase emulators:exec --only firestore --project lurexa-app \"pnpm --filter @lurexa/backend test:educator-growth-integration\"",
    "test:e2e": "pnpm --filter learn-web test:e2e",
    "test:learn-rules": "firebase emulators:exec --only auth,firestore --project lurexa-app \"pnpm --filter @lurexa/backend test:learn-rules\"",
    "test:learn-mvp-journey": "firebase emulators:exec --only auth,firestore --project lurexa-app \"pnpm --filter @lurexa/backend test:learn-mvp-journey\"",
    "verify:repository-hygiene": "node scripts/verify-repository-hygiene.mjs",
    "verify:brand-system": "node scripts/run-brand-system-verifier.mjs",
    "verify:product-registry": "node scripts/verify-product-registry-consumers.mjs",
    "verify:prototype-containment": "node scripts/verify-prototype-containment.mjs",
    "verify:documentation-truth": "node scripts/verify-documentation-truth.mjs",
    "verify:platform-package-boundaries": "node scripts/verify-platform-package-boundaries.mjs",
    "verify:environment-contracts": "node scripts/verify-environment-contracts.mjs",
    "verify:observability": "node scripts/verify-observability.mjs",
    "verify:speech-runtime": "node scripts/verify-speech-runtime.mjs",
    "verify:curriculum-portfolio": "node scripts/verify-curriculum-portfolio.mjs",
    "verify:tokens": "pnpm --filter @lurexa/tokens lint && pnpm --filter @lurexa/tokens check-types",
    "verify:core-mind-boundary": "node scripts/verify-core-mind-boundary.mjs",
    "verify:core-analytics": "node scripts/verify-core-analytics-boundary.mjs",
    "verify:superadmin-bootstrap": "tsx packages/backend/scripts/grant-superadmin.ts --help && node scripts/verify-superadmin-bootstrap.mjs",
    "verify:vercel-release": "node scripts/deploy-vercel-product.mjs --product learn-web --target preview --sha 0000000000000000000000000000000000000000",
    "verify:signature-experience": "node scripts/verify-signature-experience.mjs",
    "verify:signature-contracts": "node scripts/verify-signature-contracts-and-governance.mjs",
    "verify:curriculum-runner": "node scripts/verify-full-curriculum-runner.mjs",
    "verify:coach": "node scripts/verify-coach-product.mjs",
    "verify:assignments": "node scripts/verify-assignment-engine.mjs",
    "verify:studio": "node scripts/verify-studio-authoring.mjs",
    "verify:insight": "node scripts/verify-insight-analytics.mjs",
    "verify:field-pilot": "node scripts/verify-field-pilot-pwa.mjs",
    "verify:specialized-tracks": "node scripts/verify-specialized-tracks.mjs",
    "verify:multi-l1-profiles": "node scripts/verify-multi-l1-profiles.mjs",
    "verify:r2-storage": "node scripts/verify-r2-firestore-storage.mjs",
    "verify:optimizations": "node scripts/verify-optimization-improvements.mjs",
    "verify:tier1-design": "node scripts/verify-tier1-design-tokens.mjs",
    "verify:tier2-migration": "node scripts/verify-tier2-migration.mjs",
    "verify:tier3-ux": "node scripts/verify-tier3-ux.mjs",
    "verify:specialized-tracks-integration": "node scripts/verify-specialized-tracks-integration.mjs",
    "verify:a11y-wcag": "node scripts/verify-a11y-wcag.mjs",
    "verify:ui-ux-design": "node scripts/verify-tier1-design-tokens.mjs && node scripts/verify-tier2-migration.mjs && node scripts/verify-tier3-ux.mjs && node scripts/verify-specialized-tracks-integration.mjs && node scripts/verify-a11y-wcag.mjs",
    "verify:governance": "node scripts/verify-governance-and-quality.mjs",
    "simulate:lifecycle": "node scripts/simulate-complete-learner-lifecycle.mjs",
    "simulate:a1-pilot": "node scripts/simulate-a1-pilot-cohort.mjs",
    "verify:local": "pnpm verify:repository-hygiene && pnpm verify:brand-system && pnpm verify:product-registry && pnpm verify:prototype-containment && pnpm verify:documentation-truth && pnpm verify:platform-package-boundaries && pnpm verify:environment-contracts && pnpm verify:observability && pnpm verify:speech-runtime && pnpm verify:curriculum-portfolio && pnpm verify:curriculum-runner && pnpm verify:coach && pnpm verify:assignments && pnpm verify:studio && pnpm verify:insight && pnpm verify:field-pilot && pnpm verify:specialized-tracks && pnpm verify:multi-l1-profiles && pnpm verify:specialized-tracks-integration && pnpm verify:r2-storage && pnpm verify:optimizations && pnpm verify:tier1-design && pnpm verify:tier2-migration && pnpm verify:tier3-ux && pnpm verify:a11y-wcag && pnpm verify:governance && pnpm simulate:lifecycle && pnpm simulate:a1-pilot && pnpm verify:tokens && pnpm verify:core-mind-boundary && pnpm verify:mind-contract && pnpm verify:core-analytics && pnpm verify:superadmin-bootstrap && pnpm verify:vercel-release && pnpm verify:signature-experience && pnpm verify:signature-contracts && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "phase0:lint": "pnpm --filter learn-web... lint",
    "phase0:check-types": "pnpm --filter learn-web... check-types",
    "phase0:build": "pnpm --filter learn-web... build",
    "verify:phase0": "pnpm phase0:lint && pnpm phase0:check-types && pnpm phase0:build",
    "verify:linguistic-intelligence": "pnpm --filter @lurexa/types check-types && pnpm --filter @lurexa/backend check-types && node scripts/verify-linguistic-intelligence.mjs",
    "verify:learner-model": "pnpm --filter @lurexa/types check-types && pnpm --filter @lurexa/backend check-types && pnpm --filter learn-web check-types && node scripts/verify-learner-model.mjs",
    "verify:mind-recommendations": "tsx scripts/verify-mind-recommendations.mjs",
    "verify:mind-contract": "tsx scripts/verify-mind-contract-v1.mjs",
    "admin:grant-superadmin": "tsx packages/backend/scripts/grant-superadmin.ts",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "deploy:vercel": "node scripts/deploy-vercel-product.mjs",
    "deploy:learn:preview": "node scripts/deploy-vercel-product.mjs --product learn-web --target preview",
    "deploy:learn:production": "node scripts/deploy-vercel-product.mjs --product learn-web --target production",
    "env:learn:preview": "node scripts/sync-vercel-runtime-env.mjs --product learn-web --target preview",
    "env:learn:production": "node scripts/sync-vercel-runtime-env.mjs --product learn-web --target production"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "firebase-tools": "^15.27.0",
    "globby": "^16.2.4",
    "tsx": "4.23.11",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "firebase": "^10.12.0"
  }
}
